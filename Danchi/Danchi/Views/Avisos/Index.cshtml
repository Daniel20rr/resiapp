@model IEnumerable<ResiApp.Models.Aviso>
@{
    ViewBag.Title = "Avisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: @Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString(), true)),
            confirmButtonText: 'Aceptar',
            timer: 3000
        });
    </script>
}
<style>
    .aviso-container {
        max-width: 1100px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .aviso-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .aviso-actions {
        margin-bottom: 1.5rem;
    }

    .btn-nuevo-aviso {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nuevo-aviso:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .aviso-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .aviso-table th, .aviso-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .aviso-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .aviso-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .aviso-table tr:last-child td {
            border-bottom: none;
        }

        .aviso-table td {
            color: #374151;
        }

    .btn-action-aviso {
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-aviso-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-aviso-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-aviso-del {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-aviso-del:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }

    .estado-icon {
        font-size: 1.1rem;
        color: #16a34a;
    }

    .estado-inactivo {
        color: #9ca3af;
    }
</style>
<div class="aviso-container">
    <div class="aviso-title">Avisos</div>
    <div class="aviso-actions">
        <a href="@Url.Action("Create", "Avisos")" class="btn-nuevo-aviso">
            <i class="fas fa-plus"></i> Nuevo Aviso
        </a>
    </div>
    <table class="aviso-table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                <th>@Html.DisplayNameFor(model => model.Estado)</th>
                <th style="text-align:center;" colspan="2">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="estado-icon" title="Activo"><i class="fas fa-check-circle"></i></span>
                        }
                        else
                        {
                            <span class="estado-icon estado-inactivo" title="Inactivo"><i class="fas fa-times-circle"></i></span>
                        }
                    </td>
                    <td style="text-align:center;">
                        <a href="@Url.Action("Edit", "Avisos", new { id = item.IdAviso })" class="btn-action-aviso btn-aviso-edit">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                    </td>
                    <td style="text-align:center;">
                        <a href="@Url.Action("Delete", "Avisos", new { id = item.IdAviso })" class="btn-action-aviso btn-aviso-del">
                            <i class="fas fa-trash-alt"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>