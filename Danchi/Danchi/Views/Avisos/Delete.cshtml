@model ResiApp.Models.Aviso
@{
    ViewBag.Title = "Eliminar Aviso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .aviso-delete-container {
        max-width: 570px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .aviso-delete-title {
        color: #dc2626;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .aviso-delete-subtitle {
        color: #6b7280;
        font-size: 1rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .delete-dl {
        background: #f9fafb;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        padding: 1.2rem 1.5rem;
        margin-bottom: 2rem;
    }

        .delete-dl dt {
            font-weight: 600;
            color: #374151;
            margin-top: 0.75rem;
            font-size: 0.875rem;
        }

            .delete-dl dt:first-child {
                margin-top: 0;
            }

        .delete-dl dd {
            color: #6b7280;
            font-size: 0.95rem;
            margin-bottom: 0.25rem;
            margin-left: 0;
        }

    .aviso-delete-btns {
        display: flex;
        gap: 0.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-aviso-delete {
        background: #dc2626;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(220,38,38,0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-aviso-delete:hover {
            background: #b91c1c;
            box-shadow: 0 2px 6px rgba(220,38,38,0.3);
        }

        .btn-aviso-delete i {
            margin-right: 0.5rem;
        }

    .aviso-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .aviso-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .aviso-back-link i {
            margin-right: 0.5rem;
        }
</style>
<div class="aviso-delete-container">
    <div class="aviso-delete-title">¿Eliminar Aviso?</div>
    <div class="aviso-delete-subtitle">
        ¿Estás seguro que deseas eliminar este aviso?<br>
        <span style="color:#dc2626;">Esta acción no se puede deshacer.</span>
    </div>
    <dl class="delete-dl">
        <dt>@Html.DisplayNameFor(model => model.Titulo)</dt>
        <dd>@Html.DisplayFor(model => model.Titulo)</dd>
        <dt>@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dd>@Html.DisplayFor(model => model.Descripcion)</dd>
        <dt>Estado</dt>
        <dd>@(Model.Estado ? "Activo" : "Inactivo")</dd>
    </dl>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="aviso-delete-btns">
            <a href="@Url.Action("Index", "Avisos")" class="aviso-back-link">
                <i class="fas fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn-aviso-delete">
                <i class="fas fa-trash-alt"></i> Eliminar
            </button>
        </div>
    }
</div>