@model IEnumerable<ResiApp.Models.Aviso>
@{
    ViewBag.Title = "Avisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .avisoview-container {
        max-width: 1100px;
        margin: 2.7rem auto 0 auto;
        padding: 0 1rem;
    }

    .avisoview-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .aviso-card {
        border-radius: 0.75rem !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb !important;
        transition: transform .13s, box-shadow .15s;
        background: #fff;
        overflow: hidden;
    }

        .aviso-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.10);
            border-color: #bfdbfe !important;
        }

        .aviso-card .card-body {
            padding: 1.4rem 1.5rem;
        }

        .aviso-card .card-title {
            color: #1a202c;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.7rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .aviso-card .card-title i {
                color: #2563eb;
                font-size: 1.2rem;
            }

        .aviso-card .card-text {
            color: #6b7280;
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .aviso-card .card-footer {
            background: #f9fafb;
            border-top: 1px solid #f3f4f6;
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .badge-activo {
        background: #dcfce7;
        color: #16a34a;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }

    .badge-inactivo {
        background: #f3f4f6;
        color: #9ca3af;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }

    @@media (max-width: 767px) {
        .avisoview-title {
            font-size: 1.4rem;
        }
    }
</style>
<div class="avisoview-container">
    <div class="avisoview-title">Avisos</div>
    <div class="row">
        @foreach (var aviso in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card aviso-card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-bullhorn"></i> @aviso.Titulo
                        </h5>
                        <p class="card-text">@aviso.Descripcion</p>
                    </div>
                    <div class="card-footer text-muted">
                        <span>@aviso.FechaCreacion.ToString("dd/MM/yyyy")</span>
                        @if (aviso.Estado)
                        {
                            <span class="badge-activo">Activo</span>
                        }
                        else
                        {
                            <span class="badge-inactivo">Inactivo</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
