@model ResiApp.Models.Propietario
@{
    ViewBag.Title = "Crear Propietario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .prop-form-container {
        max-width: 900px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .prop-form-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .prop-form-group {
        margin-bottom: 1.5rem;
    }

    .prop-form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: .5rem;
        display: block;
        font-size: 0.95rem;
        letter-spacing: .01em;
    }

    .prop-form-control {
        border-radius: 0.5rem !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem !important;
        background: #ffffff !important;
        color: #374151;
        width: 100%;
        transition: all 0.15s ease;
    }

        .prop-form-control:focus {
            border-color: #2563eb !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            outline: none;
        }

        .prop-form-control:hover {
            border-color: #9ca3af !important;
        }

    .prop-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 1.5rem;
    }

    .prop-form-btns {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-prop-guardar {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-prop-guardar:hover {
            background: #1d4ed8;
            color: #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
        }

        .btn-prop-guardar i {
            margin-right: 0.5rem;
        }

    .prop-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .prop-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .prop-back-link i {
            margin-right: 0.5rem;
        }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>
<div class="prop-form-container">
    <div class="prop-form-title">Nuevo Propietario</div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="prop-form-grid">
            <div class="prop-form-group">
                @Html.LabelFor(model => model.IdTipoDocumento, new { @class = "prop-form-label" })
                @Html.DropDownListFor(model => model.IdTipoDocumento, ViewBag.IdTipoDocumento as IEnumerable<SelectListItem> ?? new List<SelectListItem>(), "-- Selecciona un tipo --", new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.IdTipoDocumento, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.NumeroDocumento, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.NumeroDocumento, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.NumeroDocumento, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.Apellidos, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.Apellidos, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.Nombres, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.Nombres, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.Nombres, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.Correo, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.Correo, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.Telefono, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.Telefono, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.Celular, new { @class = "prop-form-label" })
                @Html.TextBoxFor(model => model.Celular, new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.Celular, "", new { @class = "text-danger" })
            </div>
            <div class="prop-form-group">
                @Html.LabelFor(model => model.IdApto, "Apartamento", new { @class = "prop-form-label" })
                @Html.DropDownListFor(model => model.IdApto, ViewBag.IdApto as IEnumerable<SelectListItem> ?? new List<SelectListItem>(), "-- Selecciona un Apto --", new { @class = "prop-form-control" })
                @Html.ValidationMessageFor(model => model.IdApto, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="prop-form-btns">
            <a href="@Url.Action("Index")" class="prop-back-link">
                <i class="fas fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn-prop-guardar">
                <i class="fas fa-save"></i> Crear
            </button>
        </div>
    }
</div>
