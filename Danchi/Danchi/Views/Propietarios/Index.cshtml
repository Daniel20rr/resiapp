@model IEnumerable<ResiApp.Models.Propietario>
@{
    ViewBag.Title = "Propietarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: @Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString(), true)),
            confirmButtonText: 'Aceptar',
            timer: 3000
        });
    </script>
}
<style>
    .prop-container {
        max-width: 1600px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .prop-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .prop-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-nuevo-prop {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nuevo-prop:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
        }

    .btn-exportar-prop {
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(22, 163, 74, 0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-exportar-prop:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

    .prop-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .prop-table th, .prop-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .prop-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .prop-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .prop-table tr:last-child td {
            border-bottom: none;
        }

        .prop-table td {
            color: #374151;
        }

    .btn-action-prop {
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-prop-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-prop-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-prop-delete {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-prop-delete:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }
</style>
<div class="prop-container">
    <div class="prop-title">Propietarios</div>
    <div class="prop-actions">
        <a href="@Url.Action("Create")" class="btn-nuevo-prop">
            <i class="fas fa-plus"></i> Nuevo Propietario
        </a>
        @if (ResiApp.Utils.SessionHelper.Rol == "Administrador")
        {
            <a href="@Url.Action("ExportarEventosPDF", "Propietarios")" class="btn-exportar-prop">
                <i class="fas fa-file-pdf"></i> Exportar a PDF
            </a>
        }
    </div>
    <div style="overflow-x:auto;">
        <table class="prop-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Apto.NombreApto)</th>
                    <th>@Html.DisplayNameFor(model => model.IdTipoDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
                    <th>@Html.DisplayNameFor(model => model.Apellidos)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombres)</th>
                    <th>@Html.DisplayNameFor(model => model.Correo)</th>
                    <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                    <th>@Html.DisplayNameFor(model => model.Celular)</th>
                    <th style="text-align:center;" colspan="2">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Apto.NombreApto)</td>
                        <td>@Html.DisplayFor(modelItem => item.IdTipoDocumento)</td>
                        <td>@Html.DisplayFor(modelItem => item.NumeroDocumento)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellidos)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                        <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.Celular)</td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Edit", "Propietarios", new { id = item.IdPropietario })" class="btn-action-prop btn-prop-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Delete", "Propietarios", new { id = item.IdPropietario })" class="btn-action-prop btn-prop-delete">
                                <i class="fas fa-trash-alt"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}