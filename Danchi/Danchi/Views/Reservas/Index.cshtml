@model IEnumerable<ResiApp.Models.Reserva>
@{
    ViewBag.Title = "Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: @Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString(), true)),
            confirmButtonText: 'Aceptar',
            timer: 3000
        });
    </script>
}
<style>
    .reservas-container {
        max-width: 1200px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .reservas-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .reservas-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-nueva-reserva {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nueva-reserva:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .btn-exportar-reserva {
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(22,163,74,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-exportar-reserva:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

    .reservas-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .reservas-table th, .reservas-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .reservas-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .reservas-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .reservas-table tr:last-child td {
            border-bottom: none;
        }

        .reservas-table td {
            color: #374151;
        }

    .btn-action-reserva {
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-reserva-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-reserva-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-reserva-del {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-reserva-del:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }
</style>
<div class="reservas-container">
    <div class="reservas-title">Reservas</div>
    <div class="reservas-actions">
        <a href="@Url.Action("Create", "Reservas")" class="btn-nueva-reserva">
            <i class="fas fa-calendar-plus"></i> Nueva Reserva
        </a>
        @if (ResiApp.Utils.SessionHelper.Rol == "Administrador")
        {
            <a href="@Url.Action("ExportarEventosPDF", "Reservas")" class="btn-exportar-reserva">
                <i class="fas fa-file-pdf"></i> Exportar a PDF
            </a>
        }
    </div>
    <div style="overflow-x:auto;">
        <table class="reservas-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Zona</th>
                    <th>Fecha de Reserva</th>
                    <th>Hora Inicio</th>
                    <th>Hora Fin</th>
                    <th>Nº Invitados</th>
                    <th style="text-align:center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Usuario.Nombres + " " + item.Usuario.Apellidos)</td>
                        <td>@item.Zona</td>
                        <td>@item.FechaReserva.ToString("dd/MM/yyyy")</td>
                        <td>@item.HoraInicio</td>
                        <td>@item.HoraFin</td>
                        <td>@item.NumInvitados</td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Edit", "Reservas", new { id = item.IdReserva })" class="btn-action-reserva btn-reserva-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "Reservas", new { id = item.IdReserva })" class="btn-action-reserva btn-reserva-del">
                                <i class="fas fa-trash-alt"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>