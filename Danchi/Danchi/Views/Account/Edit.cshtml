@model ResiApp.Models.Usuario
@{
    ViewBag.Title = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .user-form-container {
        max-width: 570px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .user-form-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .user-form-group {
        margin-bottom: 1.5rem;
    }

    .user-form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: .5rem;
        display: block;
        font-size: 0.95rem;
    }

    .user-form-control {
        border-radius: 0.5rem !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem !important;
        background: #ffffff !important;
        color: #374151;
        width: 100%;
        transition: all 0.15s ease;
        box-sizing: border-box;
    }

        .user-form-control:focus {
            border-color: #2563eb !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
            outline: none;
        }

        .user-form-control:hover {
            border-color: #9ca3af !important;
        }

    .user-form-btns {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-user-guardar {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-user-guardar:hover {
            background: #1d4ed8;
            box-shadow: 0 2px 6px rgba(37,99,235,0.3);
        }

        .btn-user-guardar i {
            margin-right: 0.5rem;
        }

    .user-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .user-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .user-back-link i {
            margin-right: 0.5rem;
        }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>
<div class="user-form-container">
    <div class="user-form-title">Editar Usuario</div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.IdUsuario)
        @Html.HiddenFor(model => model.Contrasena)
        @Html.HiddenFor(model => model.HashIV)
        @Html.HiddenFor(model => model.HashKey)
        @Html.HiddenFor(model => model.FechaCreacion)
        @Html.HiddenFor(model => model.UsuarioCreacion)
        <div class="user-form-group">
            @Html.LabelFor(model => model.Nombres, new { @class = "user-form-label" })
            @Html.TextBoxFor(model => model.Nombres, new { @class = "user-form-control", placeholder = "Nombres..." })
            @Html.ValidationMessageFor(model => model.Nombres, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-group">
            @Html.LabelFor(model => model.Apellidos, new { @class = "user-form-label" })
            @Html.TextBoxFor(model => model.Apellidos, new { @class = "user-form-control", placeholder = "Apellidos..." })
            @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-group">
            @Html.LabelFor(model => model.Correo, new { @class = "user-form-label" })
            @Html.TextBoxFor(model => model.Correo, new { @class = "user-form-control", placeholder = "Correo..." })
            @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-group">
            @Html.LabelFor(model => model.Telefono, new { @class = "user-form-label" })
            @Html.TextBoxFor(model => model.Telefono, new { @class = "user-form-control", placeholder = "Teléfono o Celular..." })
            @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-group">
            @Html.LabelFor(model => model.IdRol, "Rol", new { @class = "user-form-label" })
            @Html.DropDownListFor(model => model.IdRol, (IEnumerable<SelectListItem>)ViewBag.Rol, "-- Selecciona un Rol --", new { @class = "user-form-control" })
            @Html.ValidationMessageFor(model => model.IdRol, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-group">
            @Html.LabelFor(model => model.NuevaContrasena, new { @class = "user-form-label" })
            @Html.PasswordFor(model => model.NuevaContrasena, new { @class = "user-form-control", placeholder = "Nueva Contraseña (dejar vacío para no cambiar)..." })
            @Html.ValidationMessageFor(model => model.NuevaContrasena, "", new { @class = "text-danger" })
        </div>
        <div class="user-form-btns">
            <a href="@Url.Action("Index", "Account")" class="user-back-link">
                <i class="fas fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn-user-guardar">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
        </div>
    }
</div>