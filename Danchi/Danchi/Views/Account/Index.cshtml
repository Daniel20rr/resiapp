@model IEnumerable<ResiApp.Models.Usuario>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: @Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString(), true)),
            confirmButtonText: 'Aceptar',
            timer: 3000
        });
    </script>
}
<style>
    .user-container {
        max-width: 1150px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .user-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .user-actions {
        margin-bottom: 1.5rem;
    }

    .btn-nuevo-usuario {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nuevo-usuario:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .user-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .user-table th, .user-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .user-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .user-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .user-table tr:last-child td {
            border-bottom: none;
        }

        .user-table td {
            color: #374151;
        }

    .badge-admin {
        background: #ede9fe;
        color: #7c3aed;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.825rem;
    }

    .badge-residente {
        background: #eff6ff;
        color: #2563eb;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.825rem;
    }

    .btn-action-user {
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-user-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-user-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-user-delete {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-user-delete:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }
</style>
<div class="user-container">
    <div class="user-title">Usuarios Registrados</div>
    <div class="user-actions">
        <a href="@Url.Action("Register", "Account")" class="btn-nuevo-usuario">
            <i class="fas fa-user-plus"></i> Nuevo Usuario
        </a>
    </div>
    <div style="overflow-x:auto;">
        <table class="user-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombres)</th>
                    <th>@Html.DisplayNameFor(model => model.Apellidos)</th>
                    <th>@Html.DisplayNameFor(model => model.Correo)</th>
                    <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                    <th>Rol</th>
                    <th style="text-align:center;" colspan="2">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                        <td>@Html.DisplayFor(modelItem => item.Apellidos)</td>
                        <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                        <td>
                            @if (item.Rol.DescripcionRol == "Administrador")
                            {
                                <span class="badge-admin">@item.Rol.DescripcionRol</span>
                            }
                            else
                            {
                                <span class="badge-residente">@item.Rol.DescripcionRol</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Edit", "Account", new { id = item.IdUsuario })" class="btn-action-user btn-user-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Delete", "Account", new { id = item.IdUsuario })" class="btn-action-user btn-user-delete">
                                <i class="fas fa-trash-alt"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>