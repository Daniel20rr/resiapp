@model IEnumerable<ResiApp.Models.Torre>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Torres";
}
<style>
    .torres-container {
        max-width: 850px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .torres-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 1.5rem;
        letter-spacing: -0.01em;
    }

    .torres-btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.6rem 1.4rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        text-decoration: none;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.2);
    }

        .torres-btn-create:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
        }

    .torres-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

        .torres-table th {
            background: #f9fafb;
            color: #374151;
            font-weight: 600;
            padding: 0.85rem 1rem;
            border-bottom: 2px solid #e5e7eb;
            text-align: left;
        }

        .torres-table td {
            padding: 0.85rem 1rem;
            color: #6b7280;
            border-bottom: 1px solid #f3f4f6;
        }

        .torres-table tr:hover td {
            background: #f9fafb;
        }

    .btn-torres-accion {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
    }

    .btn-torres-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-torres-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-torres-delete {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-torres-delete:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }

    @@media (max-width: 700px) {
        .torres-container {
            padding: 1rem 0.5rem;
        }

        .torres-title {
            font-size: 1.25rem;
        }

        .torres-table th, .torres-table td {
            padding: 0.6rem 0.4rem;
            font-size: 0.875rem;
        }
    }
</style>
<div class="torres-container">
    <div class="torres-title">Torres</div>
    <a href="@Url.Action("Create", "Torres")" class="torres-btn-create">
        <i class="fas fa-plus"></i> Nueva Torre
    </a>
    <div style="overflow-x:auto;">
        <table class="torres-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().NombreTorre)</th>
                    <th>@Html.DisplayNameFor(model => model.FirstOrDefault().FechaCreacion)</th>
                    <th style="text-align:center;" colspan="2">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreTorre</td>
                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm tt")</td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Edit", "Torres", new { id = item.IdTorre })" class="btn-torres-accion btn-torres-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Delete", "Torres", new { id = item.IdTorre })" class="btn-torres-accion btn-torres-delete">
                                <i class="fas fa-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>