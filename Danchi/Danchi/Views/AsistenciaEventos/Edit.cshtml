@model ResiApp.Models.AsistenciaEvento
@{
    ViewBag.Title = "Editar Asistencia a Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .asist-form-container {
        max-width: 570px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .asist-form-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .asist-form-group {
        margin-bottom: 1.5rem;
    }

    .asist-form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: .5rem;
        display: block;
        font-size: 0.95rem;
        letter-spacing: .01em;
    }

    .asist-form-control {
        border-radius: 0.5rem !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem !important;
        background: #ffffff !important;
        color: #374151;
        width: 100%;
        transition: all 0.15s ease;
    }

        .asist-form-control:focus {
            border-color: #2563eb !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            outline: none;
        }

        .asist-form-control:hover {
            border-color: #9ca3af !important;
        }

    .asist-checkbox-wrapper {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        cursor: pointer;
    }

        .asist-checkbox-wrapper:hover {
            border-color: #9ca3af;
            background: #f9fafb;
        }

        .asist-checkbox-wrapper input[type="checkbox"] {
            width: 1.1rem;
            height: 1.1rem;
            accent-color: #2563eb;
            cursor: pointer;
        }

        .asist-checkbox-wrapper span {
            font-size: 0.95rem;
            color: #374151;
            font-weight: 500;
        }

    .asist-form-btns {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-asist-guardar {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-asist-guardar:hover {
            background: #1d4ed8;
            color: #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
        }

        .btn-asist-guardar i {
            margin-right: 0.5rem;
        }

    .asist-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .asist-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .asist-back-link i {
            margin-right: 0.5rem;
        }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<div class="asist-form-container">
    <div class="asist-form-title">Editar Asistencia a Evento</div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="asist-form-group">
            <label class="asist-form-label" for="IdEvento">Evento</label>
            @Html.DropDownList("IdEvento", null, "-- Selecciona un Evento --", new { @class = "asist-form-control" })
            @Html.ValidationMessageFor(model => model.IdEvento, "", new { @class = "text-danger" })
        </div>

        <div class="asist-form-group">
            <label class="asist-form-label">Confirmado</label>
            <label class="asist-checkbox-wrapper">
                @Html.EditorFor(model => model.Confirmado)
                <span>Marcar si la asistencia está confirmada</span>
            </label>
            @Html.ValidationMessageFor(model => model.Confirmado, "", new { @class = "text-danger" })
        </div>

        <div class="asist-form-btns">
            <a href="@Url.Action("Index")" class="asist-back-link">
                <i class="fas fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn-asist-guardar">
                <i class="fas fa-save"></i> Guardar
            </button>
        </div>
    }
</div>