@model ResiApp.Models.Evento
@{
    ViewBag.Title = "Editar Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .evento-form-container {
        max-width: 650px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .evento-form-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .evento-form-group {
        margin-bottom: 1.5rem;
    }

    .evento-form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: .5rem;
        display: block;
        font-size: 0.95rem;
    }

    .evento-form-control {
        border-radius: 0.5rem !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem !important;
        background: #ffffff !important;
        color: #374151;
        width: 100%;
        transition: all 0.15s ease;
        box-sizing: border-box;
    }

        .evento-form-control:focus {
            border-color: #2563eb !important;
            background: #fff !important;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
            outline: none;
        }

        .evento-form-control:hover {
            border-color: #9ca3af !important;
        }

    .evento-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 1.5rem;
    }

    .evento-form-btns {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-evento-guardar {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-evento-guardar:hover {
            background: #1d4ed8;
            box-shadow: 0 2px 6px rgba(37,99,235,0.3);
        }

        .btn-evento-guardar i {
            margin-right: 0.5rem;
        }

    .evento-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .evento-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .evento-back-link i {
            margin-right: 0.5rem;
        }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>
<div class="evento-form-container">
    <div class="evento-form-title">Editar Evento</div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.IdEvento)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="evento-form-group">
            @Html.LabelFor(model => model.Titulo, new { @class = "evento-form-label" })
            @Html.TextBoxFor(model => model.Titulo, new { @class = "evento-form-control", placeholder = "Título del evento" })
            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
        </div>
        <div class="evento-form-group">
            @Html.LabelFor(model => model.Descripcion, new { @class = "evento-form-label" })
            @Html.TextAreaFor(model => model.Descripcion, 4, 50, new { @class = "evento-form-control", placeholder = "Descripción del evento..." })
            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
        </div>
        <div class="evento-form-grid">
            <div class="evento-form-group">
                @Html.LabelFor(model => model.FechaEvento, new { @class = "evento-form-label" })
                @Html.TextBoxFor(model => model.FechaEvento, "{0:yyyy-MM-dd}", new { @class = "evento-form-control", type = "date" })
                @Html.ValidationMessageFor(model => model.FechaEvento, "", new { @class = "text-danger" })
            </div>
            <div class="evento-form-group">
                @Html.LabelFor(model => model.Lugar, new { @class = "evento-form-label" })
                @Html.TextBoxFor(model => model.Lugar, new { @class = "evento-form-control", placeholder = "Lugar del evento" })
                @Html.ValidationMessageFor(model => model.Lugar, "", new { @class = "text-danger" })
            </div>
            <div class="evento-form-group">
                @Html.LabelFor(model => model.HoraInicio, new { @class = "evento-form-label" })
                @Html.TextBoxFor(model => model.HoraInicio, new { @class = "evento-form-control", type = "time" })
                @Html.ValidationMessageFor(model => model.HoraInicio, "", new { @class = "text-danger" })
            </div>
            <div class="evento-form-group">
                @Html.LabelFor(model => model.HoraFin, new { @class = "evento-form-label" })
                @Html.TextBoxFor(model => model.HoraFin, new { @class = "evento-form-control", type = "time" })
                @Html.ValidationMessageFor(model => model.HoraFin, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="evento-form-group">
            <label class="evento-form-label" style="display:flex;align-items:center;gap:.55rem;">
                @Html.EditorFor(model => model.Estado)
                <span>@Html.DisplayNameFor(model => model.Estado)</span>
            </label>
            @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
        </div>
        <div class="evento-form-btns">
            <a href="@Url.Action("Index", "Eventos")" class="evento-back-link">
                <i class="fas fa-arrow-left"></i> Cancelar
            </a>
            <button type="submit" class="btn-evento-guardar">
                <i class="fas fa-save"></i> Guardar
            </button>
        </div>
    }
</div>>
