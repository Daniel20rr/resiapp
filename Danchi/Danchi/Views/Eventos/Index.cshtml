@model IEnumerable<ResiApp.Models.Evento>
@{
    ViewBag.Title = "Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: @Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString(), true)),
            confirmButtonText: 'Aceptar',
            timer: 3000
        });
    </script>
}
<style>
    .eventos-container {
        max-width: 1150px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .eventos-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .eventos-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .btn-nuevo-evento {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nuevo-evento:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .btn-exportar-evento {
        background: #16a34a;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(22,163,74,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-exportar-evento:hover {
            background: #15803d;
            color: #fff;
            text-decoration: none;
        }

    .eventos-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .eventos-table th, .eventos-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .eventos-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .eventos-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .eventos-table tr:last-child td {
            border-bottom: none;
        }

        .eventos-table td {
            color: #374151;
        }

    .btn-action-evento {
        font-weight: 500;
        padding: 0.4rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.15rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-evento-edit {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-evento-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-evento-del {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .btn-evento-del:hover {
            background: #fee2e2;
            color: #b91c1c;
            text-decoration: none;
        }

    .estado-icon {
        font-size: 1.1rem;
        color: #16a34a;
    }

    .estado-inactivo {
        color: #9ca3af;
    }
</style>
<div class="eventos-container">
    <div class="eventos-title">Eventos</div>
    <div class="eventos-actions">
        <a href="@Url.Action("Create", "Eventos")" class="btn-nuevo-evento">
            <i class="fas fa-plus"></i> Nuevo Evento
        </a>
        @if (ResiApp.Utils.SessionHelper.Rol == "Administrador")
        {
            <a href="@Url.Action("ExportarEventosPDF", "Eventos")" class="btn-exportar-evento">
                <i class="fas fa-file-pdf"></i> Exportar a PDF
            </a>
        }
    </div>
    <div style="overflow-x:auto;">
        <table class="eventos-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.FechaEvento)</th>
                    <th>@Html.DisplayNameFor(model => model.HoraInicio)</th>
                    <th>@Html.DisplayNameFor(model => model.HoraFin)</th>
                    <th>@Html.DisplayNameFor(model => model.Lugar)</th>
                    <th>@Html.DisplayNameFor(model => model.Estado)</th>
                    <th style="text-align:center;" colspan="2">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>@item.FechaEvento.ToString("dd/MM/yyyy")</td>
                        <td>@item.HoraInicio.ToString(@"hh\:mm")</td>
                        <td>@item.HoraFin.ToString(@"hh\:mm")</td>
                        <td>@Html.DisplayFor(modelItem => item.Lugar)</td>
                        <td>
                            @if (item.Estado)
                            {
                                <span class="estado-icon"><i class="fas fa-check-circle"></i></span>
                            }
                            else
                            {
                                <span class="estado-icon estado-inactivo"><i class="fas fa-times-circle"></i></span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Edit", "Eventos", new { id = item.IdEvento })" class="btn-action-evento btn-evento-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </td>
                        <td style="text-align:center;">
                            <a href="@Url.Action("Delete", "Eventos", new { id = item.IdEvento })" class="btn-action-evento btn-evento-del">
                                <i class="fas fa-trash-alt"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>