
@model IEnumerable<ResiApp.Models.Evento>
@{
    ViewBag.Title = "Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .eventoview-container {
        max-width: 1100px;
        margin: 2.7rem auto 0 auto;
        padding: 0 1rem;
    }

    .eventoview-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .evento-card {
        border-radius: 0.75rem !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb !important;
        transition: transform .13s, box-shadow .15s;
        background: #fff;
        overflow: hidden;
    }

        .evento-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.10);
            border-color: #bfdbfe !important;
        }

        .evento-card .evento-header {
            background: #2563eb;
            color: #fff;
            font-weight: 700;
            font-size: 1.05rem;
            padding: 0.85rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .evento-card .evento-header i {
                font-size: 1.1rem;
            }

        .evento-card .card-body {
            padding: 1.2rem 1.5rem;
        }

        .evento-card .evento-info {
            color: #374151;
            font-size: 0.95rem;
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .evento-card .evento-info i {
                color: #2563eb;
                font-size: 0.9rem;
            }

        .evento-card .evento-desc {
            color: #6b7280;
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .evento-card .card-footer {
            background: #f9fafb;
            border-top: 1px solid #f3f4f6;
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .badge-activo {
        background: #dcfce7;
        color: #16a34a;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }

    .badge-inactivo {
        background: #f3f4f6;
        color: #9ca3af;
        font-weight: 600;
        border-radius: 0.4rem;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
    }
</style>
<div class="eventoview-container">
    <div class="eventoview-title">Eventos</div>
    <div class="row">
        @foreach (var evento in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card evento-card h-100">
                    <div class="evento-header">
                        <i class="fas fa-calendar-alt"></i> @evento.Titulo
                    </div>
                    <div class="card-body">
                        <div class="evento-info">
                            <i class="fas fa-map-marker-alt"></i> @evento.Lugar
                        </div>
                        <div class="evento-info">
                            <i class="fas fa-calendar"></i> @evento.FechaEvento.ToString("dd/MM/yyyy")
                        </div>
                        <div class="evento-info">
                            <i class="fas fa-clock"></i> @evento.HoraInicio.ToString(@"hh\:mm") - @evento.HoraFin.ToString(@"hh\:mm")
                        </div>
                        <div class="evento-desc">@evento.Descripcion</div>
                    </div>
                    <div class="card-footer">
                        <span class="text-muted" style="font-size:0.85rem;">@evento.FechaCreacion.ToString("dd/MM/yyyy")</span>
                        @if (evento.Estado)
                        {
                            <span class="badge-activo">Activo</span>
                        }
                        else
                        {
                            <span class="badge-inactivo">Inactivo</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>