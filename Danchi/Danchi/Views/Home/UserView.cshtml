@model ResiApp.Models.UsuarioDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Bienvenido";
}
<style>
    .dashboard-container {
        max-width: 1100px;
        margin: 2.7rem auto 0 auto;
        padding: 0 1rem;
    }

    .dashboard-hero {
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2.5rem 2.2rem;
        margin-bottom: 1.5rem;
        border: 1px solid #e5e7eb;
    }

        .dashboard-hero h2 {
            font-weight: 700;
            font-size: 2rem;
            color: #1a202c;
            letter-spacing: -0.01em;
            margin-bottom: 0.5rem;
        }

        .dashboard-hero p {
            font-size: 1rem;
            color: #6b7280;
            margin-bottom: 0;
        }

    .dashboard-section {
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb;
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .dashboard-section-header {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        padding: 1rem 1.5rem;
        font-weight: 700;
        font-size: 1rem;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .dashboard-section-header i {
            color: #2563eb;
        }

    .dashboard-section-body {
        padding: 1.5rem;
    }

    .msg-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .msg-item:last-child {
            border-bottom: none;
        }

        .msg-item strong {
            color: #1a202c;
            font-size: 0.95rem;
        }

        .msg-item small {
            color: #9ca3af;
            font-size: 0.825rem;
        }

    .btn-msg-ver {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        font-weight: 500;
        padding: 0.35rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 0.825rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

        .btn-msg-ver:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .quick-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .quick-card {
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: transform 0.13s, box-shadow 0.15s;
    }

        .quick-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.10);
            border-color: #bfdbfe;
        }

        .quick-card i {
            font-size: 2.2rem;
            margin-bottom: 0.75rem;
        }

        .quick-card h5 {
            font-weight: 700;
            color: #1a202c;
            font-size: 1rem;
            margin-bottom: 1rem;
        }

    .btn-quick {
        font-weight: 600;
        padding: 0.55rem 1.4rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
    }

    .btn-quick-blue {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
    }

        .btn-quick-blue:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .btn-quick-amber {
        background: #d97706;
        color: #fff;
        box-shadow: 0 1px 3px rgba(217,119,6,0.2);
    }

        .btn-quick-amber:hover {
            background: #b45309;
            color: #fff;
            text-decoration: none;
        }

    .btn-quick-teal {
        background: #0891b2;
        color: #fff;
        box-shadow: 0 1px 3px rgba(8,145,178,0.2);
    }

        .btn-quick-teal:hover {
            background: #0e7490;
            color: #fff;
            text-decoration: none;
        }

    .icon-blue {
        color: #2563eb;
    }

    .icon-amber {
        color: #d97706;
    }

    .icon-teal {
        color: #0891b2;
    }

    @@media (max-width: 900px) {
        .quick-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-container">

    <!-- Hero -->
    <div class="dashboard-hero">
        <h2><i class="fas fa-hand-wave" style="color:#2563eb;"></i> Hola, @Model.NombreCompleto</h2>
        <p>Bienvenido al sistema. Aquí puedes ver tus mensajes más recientes y acceder rápidamente a las funcionalidades.</p>
    </div>

    <!-- Mensajes no leídos -->
    <div class="dashboard-section">
        <div class="dashboard-section-header">
            <i class="fas fa-envelope"></i> Mensajes Recientes No Leídos
        </div>
        <div class="dashboard-section-body">
            @if (Model.MensajesNoLeidos.Any())
            {
                @foreach (var mensaje in Model.MensajesNoLeidos.Take(5))
                {
                    <div class="msg-item">
                        <div>
                            <strong>@mensaje.Asunto</strong><br />
                            <small>@mensaje.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <a href="@Url.Action("Details", "Mensajes", new { id = mensaje.IdMensaje })" class="btn-msg-ver">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                    </div>
                }
            }
            else
            {
                <p style="color:#9ca3af;margin:0;">No tienes mensajes nuevos.</p>
            }
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="quick-cards">
        <div class="quick-card">
            <i class="fas fa-calendar-check icon-blue"></i>
            <h5>Mis Reservas</h5>
            <a href="@Url.Action("Index", "Reservas")" class="btn-quick btn-quick-blue">
                <i class="fas fa-arrow-right"></i> Ver Reservas
            </a>
        </div>
        <div class="quick-card">
            <i class="fas fa-bullhorn icon-amber"></i>
            <h5>Avisos</h5>
            <a href="@Url.Action("AvisoView", "Avisos")" class="btn-quick btn-quick-amber">
                <i class="fas fa-arrow-right"></i> Ver Avisos
            </a>
        </div>
        <div class="quick-card">
            <i class="fas fa-calendar-alt icon-teal"></i>
            <h5>Eventos</h5>
            <a href="@Url.Action("EventoView", "Eventos")" class="btn-quick btn-quick-teal">
                <i class="fas fa-arrow-right"></i> Ver Eventos
            </a>
        </div>
    </div>

</div>