@model ResiApp.Models.BandejaViewModel
@{
    ViewBag.Title = "Bandeja de Mensajes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .msg-container {
        max-width: 1000px;
        margin: 2.7rem auto 0 auto;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2rem 2.5rem 2.5rem 2.5rem;
    }

    .msg-title {
        text-align: center;
        color: #1a202c;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: -0.01em;
    }

    .msg-actions {
        margin-bottom: 1.5rem;
    }

    .btn-nuevo-msg {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.65rem 1.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-nuevo-msg:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    .msg-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .msg-tab {
        background: transparent;
        color: #6b7280;
        border: none;
        padding: 0.7rem 2rem;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.15s ease;
    }

        .msg-tab.active, .msg-tab:hover {
            color: #2563eb;
            border-bottom: 2px solid #2563eb;
            background: transparent;
        }

    .msg-table {
        width: 100%;
        background: #fff;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

        .msg-table th, .msg-table td {
            padding: 1rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
            font-size: 0.95rem;
        }

        .msg-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .msg-table tbody tr:hover {
            background-color: #f9fafb;
        }

        .msg-table tr:last-child td {
            border-bottom: none;
        }

        .msg-table td {
            color: #374151;
        }

    .msg-leido {
        color: #16a34a;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .msg-noleido {
        color: #dc2626;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .btn-action-msg {
        font-weight: 500;
        padding: 0.35rem 0.8rem;
        border-radius: 0.4rem;
        font-size: 0.825rem;
        text-decoration: none;
        transition: all 0.15s ease;
        margin: 0 0.1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-msg-ver {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

        .btn-msg-ver:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }

    .btn-msg-reply {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

        .btn-msg-reply:hover {
            background: #dcfce7;
            color: #15803d;
            text-decoration: none;
        }
</style>
<div class="msg-container">
    <div class="msg-title">Bandeja de Mensajes</div>
    <div class="msg-actions">
        <a href="@Url.Action("Create", "Mensajes")" class="btn-nuevo-msg">
            <i class="fas fa-paper-plane"></i> Nuevo Mensaje
        </a>
    </div>
    <div class="msg-tabs">
        <button class="msg-tab active" onclick="showTab('recibidos')">
            <i class="fas fa-inbox"></i> Recibidos
        </button>
        <button class="msg-tab" onclick="showTab('enviados')">
            <i class="fas fa-paper-plane"></i> Enviados
        </button>
    </div>

    <div id="recibidos" class="tab-content-msg">
        @if (Model.Recibidos != null && Model.Recibidos.Any())
        {
            <div style="overflow-x:auto;">
                <table class="msg-table">
                    <thead>
                        <tr>
                            <th>De</th>
                            <th>Asunto</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th style="text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model.Recibidos)
                        {
                            <tr>
                                <td>@(msg.Emisor.Nombres + " " + msg.Emisor.Apellidos)</td>
                                <td>@msg.Asunto</td>
                                <td>@msg.FechaEnvio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (msg.Leido)
                                    {
                                        <span class="msg-leido"><i class="fas fa-check-circle"></i> Leído</span>
                                    }
                                    else
                                    {
                                        <span class="msg-noleido"><i class="fas fa-envelope"></i> No leído</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <a href="@Url.Action("Details", new { id = msg.IdMensaje })" class="btn-action-msg btn-msg-ver">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                    <a href="@Url.Action("Reply", new { id = msg.IdMensaje })" class="btn-action-msg btn-msg-reply">
                                        <i class="fas fa-reply"></i> Responder
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No tienes mensajes recibidos.</div>
        }
    </div>

    <div id="enviados" class="tab-content-msg" style="display:none;">
        @if (Model.Enviados != null && Model.Enviados.Any())
        {
            <div style="overflow-x:auto;">
                <table class="msg-table">
                    <thead>
                        <tr>
                            <th>Para</th>
                            <th>Asunto</th>
                            <th>Fecha</th>
                            <th style="text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model.Enviados)
                        {
                            <tr>
                                <td>@(msg.Receptor.Nombres + " " + msg.Receptor.Apellidos)</td>
                                <td>@msg.Asunto</td>
                                <td>@msg.FechaEnvio.ToString("dd/MM/yyyy")</td>
                                <td style="text-align:center;">
                                    <a href="@Url.Action("Details", new { id = msg.IdMensaje })" class="btn-action-msg btn-msg-ver">
                                        <i class="fas fa-eye"></i> Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">No has enviado mensajes.</div>
        }
    </div>
</div>
<script>
    function showTab(tab) {
        document.getElementById("recibidos").style.display = tab === "recibidos" ? "" : "none";
        document.getElementById("enviados").style.display = tab === "enviados" ? "" : "none";
        let tabs = document.getElementsByClassName("msg-tab");
        for (let i = 0; i < tabs.length; i++) tabs[i].classList.remove("active");
        if (tab === "recibidos") tabs[0].classList.add("active");
        if (tab === "enviados") tabs[1].classList.add("active");
    }
</script>
