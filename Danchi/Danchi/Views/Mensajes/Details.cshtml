@model ResiApp.Models.Mensaje
@{
    ViewBag.Title = "Detalle del Mensaje";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .detalle-container {
        max-width: 700px;
        margin: 2.7rem auto 0 auto;
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 2.5rem 2.2rem 2rem 2.2rem;
    }

    .detalle-title {
        color: #1a202c;
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        letter-spacing: -0.01em;
    }

    .detalle-info {
        background: #f9fafb;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        padding: 1.2rem 1.5rem;
        margin-bottom: 1.5rem;
    }

        .detalle-info p {
            color: #374151;
            font-size: 0.95rem;
            margin-bottom: 0.5rem;
        }

        .detalle-info strong {
            color: #1a202c;
        }

    .respuestas-label {
        font-weight: 700;
        color: #1a202c;
        font-size: 1rem;
        margin-bottom: 0.75rem;
        display: block;
    }

    .respuesta-block {
        background: #eff6ff;
        border-radius: 0.5rem;
        border: 1px solid #bfdbfe;
        padding: 0.9rem 1.1rem;
        margin-bottom: 0.75rem;
    }

        .respuesta-block strong {
            color: #2563eb;
        }

        .respuesta-block span {
            color: #9ca3af;
            font-size: 0.875rem;
        }

    .respuesta-form-group {
        margin-bottom: 1.25rem;
    }

    .respuesta-form-control {
        border-radius: 0.5rem !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem !important;
        background: #ffffff !important;
        color: #374151;
        width: 100%;
        box-sizing: border-box;
    }

        .respuesta-form-control:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
            outline: none;
        }

    .detalle-btns {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .btn-detalle-enviar {
        background: #2563eb;
        color: #fff;
        font-weight: 600;
        padding: 0.7rem 1.75rem;
        border-radius: 0.5rem;
        border: none;
        font-size: 0.95rem;
        box-shadow: 0 1px 3px rgba(37,99,235,0.2);
        transition: all 0.2s ease;
        cursor: pointer;
        flex: 1;
    }

        .btn-detalle-enviar:hover {
            background: #1d4ed8;
            box-shadow: 0 2px 6px rgba(37,99,235,0.3);
        }

        .btn-detalle-enviar i {
            margin-right: 0.5rem;
        }

    .detalle-back-link {
        color: #6b7280;
        font-weight: 500;
        text-decoration: none;
        padding: 0.7rem 1.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        background: #ffffff;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

        .detalle-back-link:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
            text-decoration: none;
        }

        .detalle-back-link i {
            margin-right: 0.5rem;
        }

    .btn-adjunto {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        font-weight: 600;
        padding: 0.4rem 1rem;
        border-radius: 0.4rem;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.15s ease;
    }

        .btn-adjunto:hover {
            background: #dbeafe;
            color: #1d4ed8;
            text-decoration: none;
        }
</style>
<div class="detalle-container">
    <div class="detalle-title">Detalle del Mensaje</div>
    <div class="detalle-info">
        <p><strong>De:</strong> @Model.Emisor.Correo</p>
        <p><strong>Para:</strong> @Model.Receptor.Correo</p>
        <p><strong>Asunto:</strong> @Model.Asunto</p>
        <p><strong>Fecha:</strong> @Model.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Mensaje:</strong><br />@Model.Descripcion</p>
        @if (!string.IsNullOrEmpty(Model.ArchivoAdjunto))
        {
            <p>
                <strong>Archivo adjunto:</strong>
                @Html.ActionLink("Descargar", "DescargarArchivo", new { id = Model.IdMensaje }, new { @class = "btn-adjunto" })
            </p>
        }
    </div>

    <span class="respuestas-label">Mensajes del hilo:</span>
    @if (Model.Respuestas != null && Model.Respuestas.Any())
    {
        foreach (var respuesta in Model.Respuestas.OrderBy(r => r.FechaEnvio))
        {
            <div class="respuesta-block">
                <p>
                    <strong>@respuesta.Emisor.Correo</strong>
                    <span>(@respuesta.FechaEnvio.ToString("dd/MM/yyyy HH:mm"))</span>
                </p>
                <div style="color:#374151;font-size:0.95rem;">@respuesta.Descripcion</div>
            </div>
        }
    }
    else
    {
        <p style="color:#9ca3af;font-size:0.9rem;">Sin respuestas.</p>
    }

    <hr style="border-color:#f3f4f6;margin:1.5rem 0;" />
    <span class="respuestas-label">Responder:</span>
    @using (Html.BeginForm("Create", "Mensajes", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("IdReceptor", Model.IdEmisor)
        @Html.Hidden("MensajePadreId", Model.IdMensaje)
        @Html.Hidden("Asunto", "RE: " + Model.Asunto)
        <div class="respuesta-form-group">
            @Html.TextArea("Descripcion", null, new { @class = "respuesta-form-control", rows = 4, placeholder = "Escribe tu respuesta..." })
        </div>
        <div class="detalle-btns">
            <a href="@Url.Action("Index", "Mensajes")" class="detalle-back-link">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
            <button type="submit" class="btn-detalle-enviar">
                <i class="fas fa-paper-plane"></i> Enviar Respuesta
            </button>
        </div>
    }
</div>